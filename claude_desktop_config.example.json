{
  "mcpServers": {
    "gitlab": {
      "command": "npx",
      "args": ["-y", "gitlab-mcp-server"],
      "env": {
        "GITLAB_URL": "https://gitlab.com",
        "GITLAB_SHARED_ACCESS_TOKEN": "glpat-your-token-here",
        "GITLAB_AUTH_MODE": "hybrid",
        "GITLAB_MAX_PAGE_SIZE": "50",
        "GITLAB_TIMEOUT": "30000"
      }
    }
  }
}

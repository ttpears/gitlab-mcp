{
  "name": "@ttpears/gitlab-mcp-server",
  "version": "4.0.0",
  "description": "GitLab MCP Server with GraphQL discovery",
  "main": "dist/index.js",
  "module": "./src/index.ts",
  "type": "module",
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "build:mcpb": "npm run build && node scripts/build-mcpb.mjs",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc -p tsconfig.test.json",
    "check:release": "node scripts/check-release.mjs",
    "docs:generate": "npm run build && node scripts/generate-tool-docs.mjs",
    "check:docs": "npm run build && node scripts/check-docs.mjs"
  },
  "bin": {
    "gitlab-mcp-server": "./dist/index.js",
    "gitlab-mcp": "./dist/index.js"
  },
  "keywords": [
    "mcp",
    "gitlab",
    "graphql",
    "model-context-protocol"
  ],
  "author": "Tim Pearson",
  "license": "MIT",
  "homepage": "https://github.com/ttpears/gitlab-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ttpears/gitlab-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/ttpears/gitlab-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "graphql": "^16.14.2",
    "graphql-request": "^7.4.0",
    "ioredis": "^6.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@swc/jest": "^0.2.39",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.1",
    "jest": "^30.5.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "icon.svg",
    "CONTRIBUTING.md",
    "docs",
    ".env.example",
    ".clauderc.example",
    "claude_desktop_config.example.json",
    "mcp.json",
    "mcp-inspector.example.json",
    "librechat.example.yml",
    "docker-compose.override.yml"
  ],
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "glob": "^14.0.3",
    "minimatch": "^11.0.3"
  }
}

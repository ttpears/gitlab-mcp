# GitLab MCP Server Configuration

# GitLab instance URL (for self-hosted GitLab)
GITLAB_URL=https://gitlab.com

# ── Fallback authentication ──────────────────────────────────────────────────
# Two role-named tokens determine fallback behavior when a request carries no
# per-call user credentials. They are MUTUALLY EXCLUSIVE — set at most one.
#
#   GITLAB_TOKEN        Full access. Used for reads AND writes.
#   GITLAB_READ_TOKEN   Read-only. Writes against it are always rejected.
#
# With neither set, every operation requires per-call user credentials (the
# recommended posture for a publicly hosted, multi-user instance — see OAuth).
# Generate at: GitLab → User Settings → Access Tokens (scope: api or read_api)
GITLAB_TOKEN=
# GITLAB_READ_TOKEN=

# ── Hardening (safe defaults; tune for your deployment) ──────────────────────
# Pin every request to the configured GITLAB_URL, ignoring any per-call/header
# gitlabUrl. Closes the SSRF vector where a caller points the server at internal
# hosts. Set to false ONLY if you intentionally serve multiple GitLab instances.
GITLAB_PIN_HOST=true

# The open-ended escape-hatch tools (execute_custom_query, execute_rest_read,
# execute_rest_write) require per-call user credentials by default. Set to true
# to also allow them to run on the shared GITLAB_TOKEN (e.g. single-operator
# stdio setups). Leave false for multi-user hosting.
GITLAB_ALLOW_SHARED_ESCAPE_HATCH=false

# Maximum page size for paginated requests (1-100)
GITLAB_MAX_PAGE_SIZE=50

# Request timeout in milliseconds
GITLAB_TIMEOUT=30000

# Max concurrent requests to GitLab across all tools/users; excess work queues
# with finite size/wait limits. 0 explicitly disables concurrency throttling.
# The per-group
# analytics project-scan cap (logs when bounded; deep mining stays available).
GITLAB_MAX_CONCURRENCY=16
GITLAB_ANALYTICS_MAX_PROJECTS=500
GITLAB_MAX_QUEUED_REQUESTS=128
GITLAB_MAX_QUEUE_WAIT_MS=15000
# Includes decompressed response bytes (16 MiB).
GITLAB_MAX_RESPONSE_BYTES=16777216

# ── HTTP transport (LibreChat / remote hosting) ──────────────────────────────
# Use GITLAB_MCP_PORT (not PORT) to avoid conflicts with LibreChat.
# Leave MCP_TRANSPORT unset for stdio (Claude Desktop/Code, VS Code).
GITLAB_MCP_PORT=8008
MCP_TRANSPORT=http
MCP_MAX_SESSIONS=1000
MCP_MAX_SESSIONS_PER_IDENTITY=10
MCP_REQUESTS_PER_MINUTE=240
MCP_MAX_INFLIGHT_PER_IDENTITY=8
MCP_MAX_INFLIGHT_REQUESTS=256

# When hosted behind a reverse proxy (traefik/nginx), trust it so req.ip and the
# OAuth endpoints' per-IP rate limiting read the real client IP from
# X-Forwarded-For. Hop count (1 = one proxy), boolean, or an IP/subnet list.
# TRUST_PROXY=1

# ── OAuth 2.1 (remote hosting; lets each user sign in with their own GitLab) ──
# When enabled, the server becomes its own Authorization Server brokering GitLab
# OAuth: it advertises protected-resource + AS metadata, supports Dynamic Client
# Registration, and gates the MCP endpoints behind a validated bearer token.
# MCP clients (Claude.ai, Claude Code) connect with zero manual token setup.
#
# Register ONE GitLab application (instance/group/user → Applications) with:
#   Redirect URI: <MCP_SERVER_URL>/gitlab/callback   (or your GITLAB_OAUTH_CALLBACK_PATH)
#   Scopes:       api (read+write) or read_api
# then set:
# GITLAB_MCP_OAUTH=true
# MCP_SERVER_URL=https://gitlab-mcp.example.com   # public HTTPS URL of THIS server
# GITLAB_OAUTH_CLIENT_ID=<application id>
# GITLAB_OAUTH_CLIENT_SECRET=<application secret>  # omit for a public/PKCE-only app
# GITLAB_OAUTH_SCOPES=api                          # space-separated; defaults to "api"
# GITLAB_OAUTH_CALLBACK_PATH=/gitlab/callback      # must match the registered redirect URI
# GITLAB_OAUTH_ALLOWED_GROUPS=team,org/subteam     # restrict to members of these GitLab groups (and their subgroups); empty = any authenticated user

# Back OAuth broker state with Redis so it survives redeploys and scales past one
# replica. Unset = in-memory (fine for stdio/single instance). Keys are namespaced
# by issuer host; REDIS_KEY_PREFIX (default "gitlab-mcp") sets the base.
# Redis values are AES-GCM encrypted; MCP token keys are hashed. Require TLS
# except for loopback or an explicitly trusted private network.
# REDIS_URL=rediss://redis.example.com:6379
# REDIS_KEY_PREFIX=gitlab-mcp
# OAUTH_STORAGE_ENCRYPTION_KEY=<64 hex characters; generate with openssl rand -hex 32>
# REDIS_ALLOW_INSECURE=false
# Share the encryption key across replicas. v4 does not read old plaintext state;
# reconnect/re-register clients after upgrade. Use a dedicated Redis ACL/namespace
# and a memory quota with noeviction. Token families expire after 30 days.

# Development settings (set to 'development' for verbose startup/debug logging)
NODE_ENV=production

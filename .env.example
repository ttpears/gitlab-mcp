# Process environment template. The server does NOT load .env automatically.
# Inject with Docker --env-file, Compose env_file, or your process manager.
# Full reference: docs/configuration.md. Never commit a file containing real secrets.
GITLAB_URL=https://gitlab.com

# Set at most ONE fallback. Full-access permits reads AND writes; read-only never
# permits writes. Leave both unset for strict per-user PAT/OAuth access.
# GITLAB_READ_TOKEN=glpat-replace-locally
# GITLAB_TOKEN=glpat-replace-locally
GITLAB_PIN_HOST=true
GITLAB_ALLOW_SHARED_ESCAPE_HATCH=false

GITLAB_MAX_PAGE_SIZE=50
GITLAB_TIMEOUT=30000
GITLAB_MAX_CONCURRENCY=16
GITLAB_MAX_QUEUED_REQUESTS=128
GITLAB_MAX_QUEUE_WAIT_MS=15000
GITLAB_MAX_RESPONSE_BYTES=16777216
GITLAB_ANALYTICS_MAX_PROJECTS=500

# Stdio is the npm default. For HTTP, set BOTH variables below (PORT is ignored).
# The Docker image already supplies these HTTP defaults.
# MCP_TRANSPORT=http
# GITLAB_MCP_PORT=8008
MCP_MAX_SESSIONS=1000
MCP_MAX_SESSIONS_PER_IDENTITY=10
MCP_REQUESTS_PER_MINUTE=240
MCP_MAX_INFLIGHT_PER_IDENTITY=8
MCP_MAX_INFLIGHT_REQUESTS=256
# MCP_ALLOWED_ORIGINS=https://client.example.com
# Match the actual proxy topology; do not trust arbitrary forwarded addresses.
# TRUST_PROXY=1

# OAuth: register ONE GitLab application with this server's exact callback URL.
# See docs/authentication.md for PKCE, client consent, group checks, and refresh.
# GITLAB_MCP_OAUTH=true
# MCP_SERVER_URL=https://gitlab-mcp.example.com
# GITLAB_OAUTH_CLIENT_ID=replace-with-application-id
# GITLAB_OAUTH_CLIENT_SECRET=replace-if-confidential-application
# GITLAB_OAUTH_SCOPES=api
# GITLAB_OAUTH_CALLBACK_PATH=/gitlab/callback
# Empty allowed groups permits any authenticated GitLab user.
# GITLAB_OAUTH_ALLOWED_GROUPS=team,org/subteam

# OAuth state is ephemeral in-memory unless Redis is set. Redis requires a
# 64-hex-character encryption key (openssl rand -hex 32), shared across replicas.
# REDIS_URL=rediss://redis.example.com:6379
# REDIS_KEY_PREFIX=gitlab-mcp
# OAUTH_STORAGE_ENCRYPTION_KEY=replace-with-64-hex-characters
# REDIS_ALLOW_INSECURE=false
# Use TLS, a dedicated ACL, and a memory quota with noeviction. Redis shares OAuth
# state, not HTTP sessions. See docs/upgrading.md before migrating v3 plaintext.
NODE_ENV=production
